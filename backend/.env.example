# --- Core ---
NODE_ENV=
# PORT is injected by Render; the server binds to it automatically.
PORT=
DATABASE_URL=
# "disable" for local; managed providers (Supabase/Render/Neon) use SSL by default.
PGSSL=
PG_POOL_MAX=

# --- Matching engine ---
MATCHING_INTERVAL_SECONDS=

# --- Auth / sessions ---
JWT_SECRET=

# --- Solana / chain access ---
SOLANA_RPC_URL=
HELIUS_API_KEY=
YELLOWSTONE_GRPC_URL=
OBSC_MINT=
USDC_MINT=

# --- Anchor program IDs ---
POOL_PROGRAM_ID=
ESCROW_PROGRAM_ID=
STAKING_PROGRAM_ID=
AGENT_PROGRAM_ID=

# --- CORS ---
# Single origin, comma-separated list, or "*". In production set this to the
# frontend's URL, e.g. https://obscura-frontend.onrender.com
# Local + prod together: http://localhost:3000,https://obscura-frontend.onrender.com
CORS_ORIGIN=

# --- Telegram fill receipts (#10) ---
# From @BotFather. Leave blank to disable Telegram delivery entirely (no-op).
TELEGRAM_BOT_TOKEN=
# Optional — the bot's @username (without @). Auto-detected from the token via
# getMe when left blank.
TELEGRAM_BOT_USERNAME=

# --- Email fill receipts via Resend (#10) ---
# From resend.com. Leave blank to disable email delivery (no-op).
RESEND_API_KEY=
# Verified sender (any address on a domain you've verified in Resend).
RESEND_FROM=Obscura <receipts@notifications.obscuraonsol.com>
