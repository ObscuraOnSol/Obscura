{
  "name": "obscura-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Obscura backend — read/stat APIs, agent order API, auth. Bun + Express + PostgreSQL (no ORM).",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "check": "tsc --noEmit",
    "migrate": "bun run src/db/migrate-cli.ts",
    "seed": "bun run src/db/seed-cli.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@noble/hashes": "^1.7.1",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "dotenv": "^16.4.7",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "@types/cors": "^2.8.17",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "bun-types": "^1.1.43"
  }
}
